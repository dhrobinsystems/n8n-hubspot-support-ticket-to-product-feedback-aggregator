#
# n8n-hubspot-support-ticket-to-product-feedback-aggregator: environment variables.
# Copy to .env for the CLI, or set the same names as n8n environment variables (the workflow reads $env).
# Every value below is a placeholder. Never commit a real token, key, portal ID or webhook URL.
# While HUBSPOT_PRIVATE_APP_TOKEN is a placeholder, everything runs in demo mode with fictional data.

# --------------------------------------------------------------------------
# Safety switches (keep both true until a sandbox run has been reviewed)
# --------------------------------------------------------------------------
# true  = read tickets, call the LLM, cluster and preview; write nothing; leave the watermark untouched.
DRY_RUN=true
# true  = refuse any HubSpot portal that is not a sandbox or developer test account,
#         and sync only to the *_SANDBOX_* team / project / database below.
SANDBOX_MODE=true

# --------------------------------------------------------------------------
# HubSpot Private App
# Scopes: tickets, crm.objects.companies.read, crm.objects.deals.read
#         (+ crm.objects.tickets.write only if TICKET_FEEDBACK_STAMP_PROPERTY is set)
# --------------------------------------------------------------------------
HUBSPOT_PRIVATE_APP_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN
# Optional: an explicit sandbox portal ID that also passes the sandbox check.
HUBSPOT_SANDBOX_PORTAL_ID=YOUR_HUBSPOT_SANDBOX_PORTAL_ID
# Optional override (EU data residency accounts still use api.hubapi.com).
# HUBSPOT_BASE_URL=https://api.hubapi.com

# --------------------------------------------------------------------------
# Ticket scan
# --------------------------------------------------------------------------
# A ticket qualifies when closed_date is set OR this property holds one of the values below.
TICKET_ESCALATION_PROPERTY=hs_ticket_priority
TICKET_ESCALATION_VALUES=HIGH,URGENT
# Optional comma-separated ticket pipeline IDs; empty = all pipelines.
TICKET_PIPELINE_IDS=
MAX_TICKETS_PER_RUN=50
# First run only: how far back to look before a watermark exists.
INITIAL_LOOKBACK_DAYS=7
MAX_TICKET_TEXT_CHARS=4000
# Optional single-line text ticket property that receives "cluster title (record key)". Empty = no ticket writes.
TICKET_FEEDBACK_STAMP_PROPERTY=

# --------------------------------------------------------------------------
# ARR impact
# --------------------------------------------------------------------------
# company_property = read ARR from a company property; closed_won_deals = sum closed-won deal amounts.
ARR_SOURCE=company_property
ARR_COMPANY_PROPERTY=annual_recurring_revenue
ARR_DEAL_PROPERTY=amount
# Companies whose max churn risk on a cluster reaches this score count toward "ARR at risk".
CHURN_RISK_THRESHOLD=60
ARR_CURRENCY=USD

# --------------------------------------------------------------------------
# LLM extraction
# --------------------------------------------------------------------------
# mock (default, offline keyword rules) | openai (any OpenAI-compatible endpoint) | anthropic
LLM_PROVIDER=mock
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_MODEL=YOUR_LLM_MODEL_NAME
# Optional override, e.g. an Azure OpenAI or self-hosted OpenAI-compatible endpoint.
# LLM_API_URL=https://llm-gateway.example.com/v1/chat/completions
LLM_MAX_ITEMS_PER_TICKET=3
LLM_MAX_TOKENS=800

# --------------------------------------------------------------------------
# Clustering
# --------------------------------------------------------------------------
# Jaccard similarity (0.1 to 1) between titles in the same category needed to join a cluster.
CLUSTER_SIMILARITY=0.5
CLUSTER_REGISTRY_LIMIT=2000
# Sync a cluster only once it holds at least this many tickets.
MIN_TICKETS_TO_SYNC=1
SYNC_OTHER_CATEGORY=false

# --------------------------------------------------------------------------
# Destination: none | linear | jira | notion
# --------------------------------------------------------------------------
FEEDBACK_DESTINATION=none
# Priority 1 when ARR at risk reaches this amount, priority 2 when ARR impact does.
HIGH_PRIORITY_ARR=50000

# Linear (personal API key, sent as the Authorization header)
LINEAR_API_KEY=YOUR_LINEAR_API_KEY
LINEAR_TEAM_ID=YOUR_LINEAR_TEAM_ID
LINEAR_SANDBOX_TEAM_ID=YOUR_LINEAR_SANDBOX_TEAM_ID

# Jira Cloud (basic auth: account email + API token)
JIRA_BASE_URL=https://YOUR_JIRA_SITE.atlassian.net
JIRA_EMAIL=automation@example.com
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN
JIRA_PROJECT_KEY=YOUR_JIRA_PROJECT_KEY
JIRA_SANDBOX_PROJECT_KEY=YOUR_JIRA_SANDBOX_PROJECT_KEY
JIRA_ISSUE_TYPE=Task

# Notion (internal integration shared with the database)
NOTION_API_KEY=YOUR_NOTION_API_KEY
NOTION_DATABASE_ID=YOUR_NOTION_DATABASE_ID
NOTION_SANDBOX_DATABASE_ID=YOUR_NOTION_SANDBOX_DATABASE_ID
NOTION_VERSION=2022-06-28

# --------------------------------------------------------------------------
# Failure alerts (optional; message text is redacted)
# --------------------------------------------------------------------------
ALERT_WEBHOOK_URL=YOUR_ALERT_WEBHOOK_URL

# Testing only: pin "now" to an ISO timestamp.
# AGGREGATOR_NOW=2026-11-16T06:00:00.000Z
